// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  roleCredentials BranchRoleCredential[]
}

model Branch {
  id            String   @id @default(uuid())
  name          String   @unique
  code          String   @unique
  address       String?
  city          String?
  state         String?
  phone         String?
  imageUrl      String?
  // Revenue goal for the month, shown on admin branch cards.
  monthlyTarget Float    @default(0)
  managerId     String?
  manager       User?    @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users                User[]
  roleCredentials      BranchRoleCredential[]
  servicePricing       BranchServicePricing[]
  transactions         BranchTransaction[]
  sessions             Session[]
  dailyBalances        DailyBalance[]
  staffPayouts         StaffPayout[]
  salaryPayments       SalaryPayment[]
  checklistTasks       ChecklistTask[]
  checklistCompletions ChecklistCompletion[]

  @@index([managerId])
}

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  category    String?
  durationMin Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchPricing BranchServicePricing[]
}

model BranchServicePricing {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionServices SessionService[]

  @@unique([branchId, serviceId])
  @@index([branchId])
  @@index([serviceId])
}

model BranchRoleCredential {
  id           String   @id @default(uuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  pinHash      String
  pinLookup    String   @unique
  // Reversible copy (AES-GCM) so admins can view the PIN in Settings. Null until the PIN is next set.
  pinEncrypted String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([branchId, roleId])
  @@index([branchId])
  @@index([roleId])
}

enum CommissionModel {
  FLAT_PERCENTAGE
  DAILY_TARGET
  MONTHLY_TARGET
}

enum TransactionType {
  GENERAL_EXPENSE
  EMPLOYEE_ADVANCE
}

enum PaymentMode {
  CASH
  GPAY
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED
}

model User {
  id                       String           @id @default(uuid())
  name                     String
  email                    String?          @unique
  pinHash                  String?
  pinEncrypted             String?
  roleId                   String
  role                     Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branchId                 String?
  branch                   Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  phone                    String?
  photoUrl                 String?
  monthlySalary            Decimal?         @db.Decimal(10, 2)
  // Performance targets (independent of the commission model).
  dailyRevenueTarget       Decimal?         @db.Decimal(10, 2)
  monthlyRevenueTarget     Decimal?         @db.Decimal(12, 2)
  commissionModel          CommissionModel?
  flatCommissionPercentage Decimal?         @db.Decimal(5, 2)
  dailyTargetAmount        Decimal?         @db.Decimal(10, 2)
  isActive                 Boolean          @default(true)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  commissionSlabs      StaffCommissionSlab[]
  employeeTransactions BranchTransaction[]   @relation("EmployeeTransactions")
  createdTransactions  BranchTransaction[]   @relation("CreatedTransactions")
  stylistSessions      Session[]             @relation("StylistSessions")
  managedBranches      Branch[]              @relation("BranchManager")
  payouts              StaffPayout[]
  salaryPayments       SalaryPayment[]

  @@index([roleId])
  @@index([branchId])
  @@index([isActive])
}

model StaffCommissionSlab {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slabOrder            Int
  minRevenue           Decimal  @db.Decimal(10, 2)
  commissionPercentage Decimal  @db.Decimal(5, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, slabOrder])
  @@index([userId])
}

model BranchTransaction {
  id          String          @id @default(uuid())
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type        TransactionType
  description String
  amount      Decimal         @db.Decimal(10, 2)
  paymentMode PaymentMode
  employeeId  String?
  employee    User?           @relation("EmployeeTransactions", fields: [employeeId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User            @relation("CreatedTransactions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([branchId, createdAt])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
  @@index([employeeId])
  @@index([createdById])
}

model Customer {
  id                               String   @id @default(uuid())
  name                             String
  phone                            String   @unique
  qualifyingCompletedSessionsCount Int      @default(0)
  rewardEarned                     Boolean  @default(false)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  sessions Session[]

  @@index([phone])
}

model Session {
  id               String        @id @default(uuid())
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stylistId        String?
  stylist          User?         @relation("StylistSessions", fields: [stylistId], references: [id], onDelete: Restrict)
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerMobile   String?
  status           SessionStatus @default(ACTIVE)
  subtotal         Decimal       @default(0.00) @db.Decimal(10, 2)
  discountType     DiscountType  @default(NONE)
  discountValue    Decimal       @default(0.00) @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0.00) @db.Decimal(10, 2)
  tipAmount        Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount      Decimal       @default(0.00) @db.Decimal(10, 2)
  paymentMode      PaymentMode?
  startedAt        DateTime?
  closedAt         DateTime?
  isLoyaltyCounted Boolean       @default(false)
  /**
   * The customer's free-haircut visit (every 6th); decided when the bill is closed and kept for later edits.
   */
  isFreeVisit      Boolean       @default(false)
  isEdited         Boolean       @default(false)
  editedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  services SessionService[]
  products SessionProduct[]

  @@index([branchId])
  @@index([stylistId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  // Reports and dashboards filter completed bills by branch / stylist and close time.
  @@index([branchId, status, closedAt])
  @@index([stylistId, status, closedAt])
}

model SessionService {
  id               String                @id @default(uuid())
  sessionId        String
  session          Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  servicePricingId String?
  servicePricing   BranchServicePricing? @relation(fields: [servicePricingId], references: [id], onDelete: SetNull)
  serviceName      String
  price            Decimal               @db.Decimal(10, 2)
  isCustom         Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([sessionId])
  @@index([servicePricingId])
}

model SessionProduct {
  id          String      @id @default(uuid())
  sessionId   String
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productName String
  price       Decimal     @db.Decimal(10, 2)
  paymentMode PaymentMode @default(CASH)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sessionId])
}

enum PayoutKind {
  COMMISSION
  TIP_WITHDRAWAL
}

enum SalaryVia {
  CASH
  GPAY
  BANK_TRANSFER
}

/// Morning opening and evening closing cash/GPay balances, one row per branch per day.
model DailyBalance {
  id           String    @id @default(uuid())
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  openingCash  Decimal   @default(0.00) @db.Decimal(12, 2)
  openingGpay  Decimal   @default(0.00) @db.Decimal(12, 2)
  openingSetAt DateTime?
  expectedCash Decimal?  @db.Decimal(12, 2)
  expectedGpay Decimal?  @db.Decimal(12, 2)
  closingCash  Decimal?  @db.Decimal(12, 2)
  closingGpay  Decimal?  @db.Decimal(12, 2)
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([branchId, date])
  @@index([branchId])
}

/// Commission payouts and tip withdrawals handed to staff (the payout ledger).
model StaffPayout {
  id          String      @id @default(uuid())
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind        PayoutKind  @default(COMMISSION)
  amount      Decimal     @db.Decimal(10, 2)
  paymentMode PaymentMode
  forDate     DateTime    @db.Date
  note        String?
  createdAt   DateTime    @default(now())

  @@index([branchId, forDate])
  @@index([userId])
}

/// Monthly salary payments recorded from the admin payroll screen.
model SalaryPayment {
  id        String    @id @default(uuid())
  branchId  String?
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount    Decimal   @db.Decimal(10, 2)
  via       SalaryVia @default(GPAY)
  note      String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Daily checklist template. branchId = null means the task applies to every branch.
model ChecklistTask {
  id          String   @id @default(uuid())
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  task        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions ChecklistCompletion[]

  @@index([branchId])
}

/// A checklist task ticked off at a branch on a given day.
model ChecklistCompletion {
  id          String        @id @default(uuid())
  taskId      String
  task        ChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  completedAt DateTime      @default(now())

  @@unique([taskId, branchId, date])
  @@index([branchId, date])
}

/// Retail products sold at checkout (shown in the billing screen and managed by admins).
model Product {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// ── WhatsApp (bills to customers, reports to admins) ───────────────────

enum WhatsappKind {
  BILL
  REPORT
  TEST
  OFFER
}

enum WhatsappStatus {
  PENDING
  SENT
  FAILED
}

/**
 * One outgoing WhatsApp template message. `dedupeKey` makes every send happen at most once.
 */
model WhatsappMessage {
  id                String         @id @default(uuid())
  dedupeKey         String         @unique
  kind              WhatsappKind
  status            WhatsappStatus @default(PENDING)
  to                String
  template          String
  params            Json
  sessionId         String?
  /**
   * Set for offers, so a broadcast's delivery can be counted.
   */
  offerId           String?
  /**
   * Optional image for the template header: { id } of an uploaded media file, or { link }.
   */
  header            Json?
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now())
  lastError         String?
  providerMessageId String?
  /**
   * Held while one process is sending this row, so two server instances never send it twice.
   */
  lockedUntil       DateTime?
  /**
   * What WhatsApp reported after accepting it: "delivered", "read" or "failed" (webhook).
   */
  deliveryStatus    String?
  deliveredAt       DateTime?
  readAt            DateTime?
  /**
   * WhatsApp's error code for the last failure, when it gave one.
   */
  errorCode         Int?
  createdAt         DateTime       @default(now())
  sentAt            DateTime?

  @@index([providerMessageId])
  @@index([status, nextAttemptAt])
  @@index([sessionId])
  @@index([offerId])
}

/**
 * An offer broadcast the admin sent to customers on WhatsApp.
 */
model WhatsappOffer {
  id          String   @id @default(uuid())
  message     String
  imageUrl    String?
  /**
   * Branches whose customers were targeted; empty means every branch.
   */
  branchIds   String[]
  audience    Int      @default(0)
  /**
   * Fingerprint of message + picture + branches, so the same offer can't be sent twice in a row.
   */
  contentHash String?
  createdAt   DateTime @default(now())

  @@index([contentHash, createdAt])
}

/**
 * Numbers that must not be messaged: replied STOP (offers) or WhatsApp said they can't receive messages.
 */
model WhatsappSuppression {
  phone     String   @id
  /// STOP (no offers) or UNDELIVERABLE (not on WhatsApp; retried after 30 days)
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Small key/value store for admin-editable settings (e.g. who receives WhatsApp reports).
 */
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
