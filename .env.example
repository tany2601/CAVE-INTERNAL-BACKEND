DATABASE_URL=postgresql://postgres:password@localhost:5432/cave_db?schema=public
# Most database connections this server may hold open. Supabase's pooler allows 15 in total across ALL servers
# using the database (your laptop + the live server + migrations), so keep the sum under 15, e.g. 4 here and 8 live.
# DB_POOL_MAX=5
DIRECT_URL=postgresql://postgres:password@localhost:5432/cave_db?schema=public
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Signs every login token. In production it MUST be a random string of 32+ characters
# (generate one with: openssl rand -base64 48). The API refuses to start with a weaker one.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Daily revenue target for stylists without one set (defaults to 9000)
# DEFAULT_DAILY_TARGET=9000

# Interface to listen on. Use 127.0.0.1 when nginx proxies to the API on the same server.
# HOST=127.0.0.1

# Production hardening
# Number of reverse proxies in front of the API (nginx = 1). Needed so rate limits and PIN lockouts
# see the real client address. Defaults to 1 when NODE_ENV=production.
# TRUST_PROXY=1
# Swagger docs at /api/docs are off in production unless this is "true".
# ENABLE_DOCS=false
# Key that protects the PINs shown in Admin -> Settings. Defaults to JWT_SECRET; if you ever rotate
# JWT_SECRET, set this to the OLD value first so existing PINs stay readable.
# PIN_VAULT_KEY=

# WhatsApp (bills to customers, daily/weekly/monthly reports to admins) - see docs/whatsapp-setup.md.
# Leave these empty to keep WhatsApp off; billing works exactly the same without it.
# WHATSAPP_TOKEN=            # permanent access token of your Meta system user
# WHATSAPP_PHONE_NUMBER_ID=  # the phone number id shown in WhatsApp Manager
# WHATSAPP_BILL_TEMPLATE=cave_bill
# WHATSAPP_REPORT_TEMPLATE=cave_report
# WHATSAPP_REPORT_FILE_TEMPLATE=cave_report_file
# WHATSAPP_BILL_IMAGE_TEMPLATE=cave_bill_image
# WHATSAPP_OFFER_TEMPLATE=cave_offer
# WHATSAPP_OFFER_IMAGE_TEMPLATE=cave_offer_image
# Webhook (delivery ticks and STOP replies): Meta app secret and a random string you also enter in Meta.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Offer safety: most offers per 24 hours, and days before the same customer may get another.
# WHATSAPP_OFFER_DAILY_LIMIT=200
# WHATSAPP_OFFER_MIN_DAYS=7
# WHATSAPP_TEMPLATE_LANG=en
# ADMIN_WHATSAPP=9876543210  # optional: report recipients until you set them in Admin -> Settings

# Admin assistant (Baron) natural voice. Leave empty to use the device's own voice.
# OPENAI_API_KEY=
# TTS_VOICE=ash
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# TTS_PROVIDER=
